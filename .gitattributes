# Keep GitHub language statistics focused on the project's own MATLAB code.
third_party/** linguist-vendored

# Force GitHub Linguist to classify MATLAB source and Live Scripts correctly.
*.m linguist-language=MATLAB
*.mlx linguist-language=MATLAB

# R Markdown notebooks contain the publication R analysis.
*.Rmd linguist-language=R

# Preserve intentional trailing spaces in historical scientific CSV fields.
r_analysis/Calculations/*.csv -whitespace

# MATLAB Live Scripts are binary ZIP-based documents.
*.mlx binary

# Scientific input workbooks are binary files.
*.xlsx binary
